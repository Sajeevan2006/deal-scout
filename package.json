{
  "name": "deal-scout",
  "version": "0.2.0",
  "private": true,
  "description": "Personal RedFlagDeals Hot Deals watcher on the Cloudflare free plan, with Telegram alerts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply deal-scout --local",
    "db:migrate:remote": "wrangler d1 migrations apply deal-scout --remote",
    "logs": "wrangler tail",
    "remote": "tsx scripts/remote.ts",
    "telegram:setup": "tsx scripts/remote.ts telegram:setup",
    "status": "tsx scripts/remote.ts status",
    "watch:add": "tsx src/local/cli.ts watch:add",
    "watch:list": "tsx src/local/cli.ts watch:list",
    "watch:remove": "tsx src/local/cli.ts watch:remove",
    "check": "tsx src/local/cli.ts check",
    "check:loop": "tsx src/local/cli.ts check:loop",
    "feedback": "tsx src/local/cli.ts feedback",
    "feed:capture": "tsx scripts/captureFeed.ts",
    "titles:collect": "tsx scripts/collectTitles.ts",
    "labels:pull": "tsx scripts/labelsPull.ts",
    "labels:sync": "tsx scripts/syncLabels.ts",
    "eval": "tsx scripts/eval.ts",
    "bench": "tsx scripts/benchCpu.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
