# Copy to .env for the local CLI and scripts (npm run eval, check, remote, labels:pull). Never commit .env.

# Optional contact for the User-Agent when the local CLI fetches the live feed
# DEAL_SCOUT_CONTACT=

# Real Workers AI from your machine (eval, local checks). Optional: without these, the CLI
# uses an offline word-overlap embedder and rule-based planner.
# Account id: Cloudflare dashboard -> Workers & Pages -> right sidebar.
# Token: My Profile -> API Tokens -> Create Token -> "Workers AI" template (read + edit).
# CLOUDFLARE_ACCOUNT_ID=
# WORKERS_AI_API_TOKEN=

# Or Claude for the planner and judge
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Talking to your deployed Worker (npm run remote, status, telegram:setup, labels:pull)
# WORKER_URL=https://deal-scout.<your-subdomain>.workers.dev
# ADMIN_TOKEN=
