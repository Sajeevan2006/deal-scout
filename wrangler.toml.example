# Copy this file to wrangler.toml, then fill in database_id.
# Everything here fits the Cloudflare free plan. See the README for the full setup.

name = "deal-scout"
main = "src/worker/index.ts"
compatibility_date = "2026-11-01"

# Check the feed every 10 minutes. Never go under 2 (the code refuses to fetch more often anyway).
[triggers]
crons = ["*/10 * * * *"]

# D1 database, exposed to the Worker as env.DB.
# Create it with: npx wrangler d1 create deal-scout   (then paste the id below)
[[d1_databases]]
binding = "DB"
database_name = "deal-scout"
database_id = "<paste the id from wrangler d1 create>"
migrations_dir = "migrations"

# Workers AI (embeddings + LLM), exposed as env.AI. Free allowance: 10,000 neurons a day.
[ai]
binding = "AI"

# Workers Logs, so you can see each run and its CPU time in the dashboard
[observability]
enabled = true

[vars]
# Optional settings (defaults shown)
# CONTACT_EMAIL = ""                   # adds "contact <email>" to the User-Agent, if you want RFD to be able to reach you
# EMBEDDING_MODEL = "@cf/baai/bge-base-en-v1.5"
# LLM_PROVIDER = "workers-ai"          # or "anthropic" (then: wrangler secret put ANTHROPIC_API_KEY)
# PLANNER_MODEL = "@cf/meta/llama-3.3-70b-instruct-fp8-fast"   # claude-haiku-5-5 with anthropic
# JUDGE_MODEL = "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
# HIGH_THRESHOLD = "0.8"               # for new watches; tune with npm run eval
# LOW_THRESHOLD = "0.6"
# MAX_JUDGE_CALLS_PER_RUN = "8"
# MAX_JUDGE_CALLS_PER_DAY = "300"

# Secrets go in with `npx wrangler secret put <NAME>` (or .dev.vars for wrangler dev), never in this file:
#   ADMIN_TOKEN              protects the /api admin endpoints
#   PAIRING_CODE             you send /start <PAIRING_CODE> to your bot once to claim it
#   TELEGRAM_BOT_TOKEN       from @BotFather (optional until you set up Telegram)
#   TELEGRAM_WEBHOOK_SECRET  any random string of letters, digits, _ or -
#   ANTHROPIC_API_KEY        only with LLM_PROVIDER = "anthropic"
